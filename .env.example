# Promise View Acres — environment variables
# Copy to .env.local for local dev, and set the same in Amplify → Hosting →
# Environment variables for production. None of these are committed.

# ── Canonical site URL (SEO / OpenGraph / sitemap) ──────────────────────
# Absolute origin the live site is served from, no trailing slash. Used to
# build canonical URLs, OpenGraph/Twitter card URLs, sitemap, and robots.
# Defaults to https://promiseviewacres.com. Point at the Amplify preview URL
# while testing so social cards resolve there instead of the live domain.
NEXT_PUBLIC_SITE_URL=https://promiseviewacres.com

# ── Contact form (AWS SES) ──────────────────────────────────────────────
# The verified SES "from" address (must be a verified identity in SES).
CONTACT_FROM_EMAIL=no-reply@promiseviewacres.com
# Where contact submissions are delivered (defaults to the gmail if unset).
CONTACT_TO_EMAIL=promiseviewacres@gmail.com
# SES region (falls back to AWS_REGION, then us-east-1).
CONTACT_SES_REGION=us-east-1
# AWS credentials: NOT needed on Amplify if the compute role has ses:SendEmail.
# For local dev, provide an IAM user's keys with ses:SendEmail:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── Ebook sale (Stripe) ─────────────────────────────────────────────────
# Secret key from the Stripe dashboard. Use a test key (sk_test_...) locally,
# the live key (sk_live_...) in Amplify prod.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (whsec_...). Local: printed by
# `stripe listen`. Prod: shown when you create the endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=
# The Stripe-hosted Payment Link the "Buy the Ebook" button points at. Public
# (NEXT_PUBLIC_) because it's used in the browser. Falls back to a placeholder
# in src/content/ebook.ts if unset.
NEXT_PUBLIC_EBOOK_PAYMENT_LINK=
# The ebook PDF is emailed as an attachment via the SAME SES identity as the
# contact form (CONTACT_FROM_EMAIL / CONTACT_SES_REGION above) — no extra vars.

# ── The Journey (YouTube Data API v3) ───────────────────────────────────
# Free API key from Google Cloud Console. Without it the Journey page renders
# from the committed seed; with it, exact dates + auto-updates on new uploads.
YOUTUBE_API_KEY=
